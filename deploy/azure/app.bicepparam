using './app.bicep'

param location = readEnvironmentVariable('ABDA_DEPLOY_LOCATION', 'eastus2')
param appName = readEnvironmentVariable('ABDA_DEPLOY_APP_NAME', 'abda-nl-web')
param containerAppsEnvironmentName = readEnvironmentVariable('ABDA_DEPLOY_ENVIRONMENT_NAME')
param imageRepository = readEnvironmentVariable('ABDA_DEPLOY_IMAGE_REPOSITORY')
param imageSha256 = readEnvironmentVariable('ABDA_DEPLOY_IMAGE_SHA256')
param deploymentEnvironment = readEnvironmentVariable('ABDA_DEPLOY_ENVIRONMENT', 'staging')
param customHostname = readEnvironmentVariable('ABDA_DEPLOY_CUSTOM_HOSTNAME', '')
param customDomainCertificateId = readEnvironmentVariable('ABDA_DEPLOY_CUSTOM_DOMAIN_CERTIFICATE_ID', '')
param oidcMetadataUrl = readEnvironmentVariable('ABDA_DEPLOY_OIDC_METADATA_URL')
param oidcIssuer = readEnvironmentVariable('ABDA_DEPLOY_OIDC_ISSUER')
param oidcClientId = readEnvironmentVariable('ABDA_DEPLOY_OIDC_CLIENT_ID')
param foundryEndpoint = readEnvironmentVariable('ABDA_DEPLOY_FOUNDRY_ENDPOINT')
param foundryOpenaiEndpoint = readEnvironmentVariable('ABDA_DEPLOY_FOUNDRY_OPENAI_ENDPOINT')
param foundryOpusEndpoint = readEnvironmentVariable('ABDA_DEPLOY_FOUNDRY_OPUS_ENDPOINT')
param foundryClaudeDeployment = readEnvironmentVariable('ABDA_DEPLOY_CLAUDE_DEPLOYMENT', 'claude-sonnet-5')
param gcpProject = readEnvironmentVariable('ABDA_DEPLOY_GCP_PROJECT')
param gcpAdcJson = readEnvironmentVariable('ABDA_DEPLOY_GCP_ADC_JSON')
param foundryOpusApiKey = readEnvironmentVariable('ABDA_DEPLOY_FOUNDRY_OPUS_API_KEY')
param postgresHost = readEnvironmentVariable('ABDA_DEPLOY_POSTGRES_HOST')
param postgresAppLogin = readEnvironmentVariable('ABDA_DEPLOY_POSTGRES_APP_LOGIN', 'abda_app')
param postgresAppPassword = readEnvironmentVariable('ABDA_DEPLOY_POSTGRES_APP_PASSWORD')
param sessionSecret = readEnvironmentVariable('ABDA_DEPLOY_SESSION_SECRET')
param mcpTokenPepper = readEnvironmentVariable('ABDA_DEPLOY_MCP_TOKEN_PEPPER')
param creditEligibilityPepper = readEnvironmentVariable('ABDA_DEPLOY_CREDIT_ELIGIBILITY_PEPPER')
param metricsToken = readEnvironmentVariable('ABDA_DEPLOY_METRICS_TOKEN')
param oidcClientSecret = readEnvironmentVariable('ABDA_DEPLOY_OIDC_CLIENT_SECRET')
param foundryApiKey = readEnvironmentVariable('ABDA_DEPLOY_FOUNDRY_API_KEY')
param openrouterApiKey = readEnvironmentVariable('ABDA_DEPLOY_OPENROUTER_API_KEY')
param openrouterBudgetMicrousd = int(readEnvironmentVariable('ABDA_DEPLOY_OPENROUTER_BUDGET_MICROUSD', '500000000'))
param trialEnabled = bool(readEnvironmentVariable('ABDA_DEPLOY_TRIAL_ENABLED', 'false'))
param trialMaxUsers = int(readEnvironmentVariable('ABDA_DEPLOY_TRIAL_MAX_USERS', '100'))
param trialBudgetMicrousd = int(readEnvironmentVariable('ABDA_DEPLOY_TRIAL_BUDGET_MICROUSD', '500000000'))
param openrouterFailoverEnabled = bool(readEnvironmentVariable('ABDA_DEPLOY_OPENROUTER_FAILOVER_ENABLED', 'false'))
