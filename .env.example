# Local development works without editing this file. Copy only the settings you need.
ABDA_ENVIRONMENT=development
ABDA_AUTH_MODE=dev

# Public deployments use a PostgreSQL URL and require migrations before startup.
# ABDA_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
# ABDA_AUTO_CREATE_DB=0
# The Azure B1ms deployment budgets at most five connections per web replica.
# ABDA_DATABASE_POOL_SIZE=4
# ABDA_DATABASE_MAX_OVERFLOW=1
# ABDA_DATABASE_POOL_TIMEOUT_SECONDS=10

# OIDC supports Auth0, Microsoft Entra External ID, and other conforming providers.
# ABDA_AUTH_MODE=oidc
# ABDA_PUBLIC_BASE_URL=https://demo.example.org
# ABDA_SESSION_SECRET=generate-at-least-32-random-characters
# ABDA_MCP_TOKEN_PEPPER=generate-a-different-32-character-secret
# Retain this distinct key for the credit program lifetime, including rollbacks.
# ABDA_CREDIT_ELIGIBILITY_PEPPER=generate-a-stable-distinct-32-character-secret
# ABDA_METRICS_TOKEN=generate-a-third-32-character-secret
# ABDA_SESSION_COOKIE=__Host-abda_session
# ABDA_TRUSTED_HOSTS=demo.example.org
# ABDA_OIDC_METADATA_URL=https://YOUR_AUTH0_TENANT/.well-known/openid-configuration
# ABDA_OIDC_ISSUER=https://YOUR_AUTH0_TENANT/
# ABDA_OIDC_CLIENT_ID=YOUR_CLIENT_ID
# ABDA_OIDC_CLIENT_SECRET=YOUR_CLIENT_SECRET

# Funded public routes require all Azure/GCP settings before hosted startup.
# Configure the funded GCP project and ADC, never a personal Gemini API key.
# AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
# AZURE_OPENAI_API_KEY=configure-in-a-secret-store
# ANTHROPIC_FOUNDRY_CLAUDE_SONNET_5_MODEL=claude-sonnet-5
# AZURE_OPUS5_ENDPOINT=https://YOUR-OPUS-RESOURCE.services.ai.azure.com
# AZURE_OPUS5_API_KEY=configure-in-a-secret-store
# AZURE_OPENAI_GPT_5_6_TERRA_DEPLOYMENT=gpt-5.6-terra
# AZURE_OPENAI_GPT_5_6_SOL_DEPLOYMENT=gpt-5.6-sol
# AZURE_OPENAI_GLM_5_3_DEPLOYMENT=glm-5.3
# AZURE_OPENAI_KIMI_K3_DEPLOYMENT=kimi-k3
# GOOGLE_CLOUD_PROJECT=YOUR-CLOUDBANK-PROJECT
# GOOGLE_CLOUD_QUOTA_PROJECT=YOUR-CLOUDBANK-PROJECT
# GOOGLE_CLOUD_LOCATION=global
# GOOGLE_APPLICATION_CREDENTIALS=/protected/path/to/adc.json

# These defaults encode the approved free-trial liability cap.
# Keep activation closed until staging and budget acceptance pass.
ABDA_TRIAL_ENABLED=0
ABDA_TRIAL_MAX_USERS=100
ABDA_TRIAL_GRANT_MICROUSD=5000000
ABDA_TRIAL_BUDGET_MICROUSD=500000000

# Public funded requests require verified authentication and trial credit.
ABDA_LLM_DEFAULT_PROFILE=balanced
ABDA_LLM_ALLOW_BYOK=1
# ABDA_LLM_REQUIRE_AUTH=1
# Local Ollama/legacy direct calls require explicit development-only opt-in.
# ABDA_LLM_ALLOW_LEGACY_DEVELOPMENT=1
ABDA_LLM_RETRY_ATTEMPTS=2
ABDA_LLM_CIRCUIT_COOLDOWN_SECONDS=15

# Public request and abuse boundaries. Rate limits are shared through PostgreSQL.
ABDA_MAX_REQUEST_BODY_BYTES=2000000
# ABDA_PROXY_MODE=azure-container-apps
# ABDA_ABUSE_PROTECTION_ENABLED=1
ABDA_ANONYMOUS_REQUESTS_PER_MINUTE=120
ABDA_MUTATION_REQUESTS_PER_MINUTE=60
ABDA_LLM_REQUESTS_PER_MINUTE=20

# Example curators are matched against active, verified account emails.
# No administrators are enabled by default. This grants scenario curation only.
# ABDA_SCENARIO_ADMIN_EMAILS=curator@example.edu,another-curator@example.edu
ABDA_COMMUNITY_CATALOG_ENABLED=1

# OpenRouter is an outage-only fallback. The default hard cap is $500.
# OPENROUTER_API_KEY=configure-in-a-secret-store
ABDA_OPENROUTER_FAILOVER_ENABLED=0
ABDA_OPENROUTER_BUDGET_MICROUSD=500000000
# A value above $500 also requires this exact acknowledgement:
# ABDA_OPENROUTER_BUDGET_ACK=I_ACCEPT_UP_TO_1000_USD
